#!/bin/sh
# Vérifie que le message de commit suit les Conventional Commits.
# Format : type(portée)!: description
fichier="$1"
sujet=$(sed -n '1p' "$fichier")

case "$sujet" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

# Préfixes d'autosquash (git commit --fixup / --squash) : on valide la suite.
sujet=$(printf '%s\n' "$sujet" | sed -E 's/^(fixup|squash|amend)! //')

if printf '%s\n' "$sujet" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .*[^ ].*$'; then
  exit 0
fi

cat >&2 <<MSG
Message de commit refusé : il doit suivre les Conventional Commits.

  Format  : type(portée optionnelle)!: description
  Types   : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  Exemple : feat(api): ajoute la route de santé

Message reçu : $sujet
MSG
exit 1
