#!/bin/sh
# Recherche de secrets dans les fichiers indexés (la CI reste le vrai filet).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --config .gitleaks.toml --pre-commit --staged --redact --no-banner
else
  echo "Avertissement : gitleaks n'est pas installé, analyse des secrets ignorée (brew install gitleaks)." >&2
fi
