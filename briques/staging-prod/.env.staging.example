# À copier en .env dans STAGING_DIR (chmod 600), jamais dans Git.
# Sans COMPOSE_FILE, deploy.sh viserait compose.prod.yaml.
COMPOSE_FILE=compose.staging.yaml
IMAGE=ghcr.io/mon-organisation/mon-projet
# Valeur initiale : deploy.sh la remplace à chaque déploiement.
IMAGE_TAG=0.0.0
# Ports publiés (8080 et 8443 par défaut, la prod garde 80 et 443).
HTTP_PORT=8080
HTTPS_PORT=8443
