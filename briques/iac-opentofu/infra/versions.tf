terraform {
  required_version = ">= 1.6.0"

  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.6"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Chemin du state passé à l'init : -backend-config="path=..." (voir BRIQUE.md).
  backend "local" {}
}
