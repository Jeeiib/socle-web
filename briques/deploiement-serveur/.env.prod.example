# À copier en .env sur le serveur (chmod 600), jamais dans Git.
# Lu par Docker Compose (variables du fichier compose) et transmis à l'application (env_file).
COMPOSE_FILE=compose.prod.yaml
# Image publiée par release.yml (nom en minuscules).
IMAGE=ghcr.io/mon-organisation/mon-projet
# Valeur initiale : deploy.sh la remplace à chaque déploiement.
IMAGE_TAG=0.0.0
# Ports publiés, seulement si 80 et 443 sont déjà pris.
# HTTP_PORT=80
# HTTPS_PORT=443
