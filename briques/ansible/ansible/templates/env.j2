{# Modèle Jinja2 du .env de production lu par Docker Compose et transmis à l'application. #}
# Fichier généré par Ansible : ne pas modifier à la main (le prochain passage l'écraserait).
COMPOSE_FILE={{ compose_file }}
IMAGE={{ image }}
# Valeur initiale : deploy.sh la remplace à chaque déploiement.
IMAGE_TAG={{ image_tag }}
APP_ENV=production
DATABASE_URL=postgres://app:{{ db_password }}@db:5432/app
POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD={{ db_password }}
